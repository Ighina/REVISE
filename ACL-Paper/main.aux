\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Held-out AUROC of the best-layer probe on paired activation updates $\Delta h$ (document split; 95\% question-level bootstrap intervals). ``nuis.'': AUROC of a classifier that sees only surface properties of the increment (nuisance covariates such as length change, presence of the answer string, lexical relevance and change in output confidence). ``gain'': AUROC added when the probe score is given to that classifier. The last row is a different task: the state-sufficiency probe classifies single contexts (raw activation $h(C)$, sufficient vs.\ insufficient), not transitions, so its AUROC is not comparable with the rows above (\cref  {sec:method,sec:what}).}}{5}{table.caption.13}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:probes}{{1}{5}{Held-out AUROC of the best-layer probe on paired activation updates $\Delta h$ (document split; 95\% question-level bootstrap intervals). ``nuis.'': AUROC of a classifier that sees only surface properties of the increment (nuisance covariates such as length change, presence of the answer string, lexical relevance and change in output confidence). ``gain'': AUROC added when the probe score is given to that classifier. The last row is a different task: the state-sufficiency probe classifies single contexts (raw activation $h(C)$, sufficient vs.\ insufficient), not transitions, so its AUROC is not comparable with the rows above (\cref {sec:method,sec:what})}{table.caption.13}{}}
\newlabel{tab:probes@cref}{{[table][1][]1}{[1][4][]5}{}{}{}}
